    {
      "cell_type": "code",
      "source": [
        "# SPLIT DATA\n",
        "train_df, temp_df = train_test_split(\n",
        "    df,\n",
        "    test_size=0.30,\n",
        "    stratify=df['label'],\n",
        "    random_state=SEED\n",
        ")\n",
        "\n",
        "val_df, test_df = train_test_split(\n",
        "    temp_df,\n",
        "    test_size=0.50,\n",
        "    stratify=temp_df['label'],\n",
